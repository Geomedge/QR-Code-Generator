<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QR_Code_Generator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QR_Code_Generator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QR Code Generator">

    <!-- Left Top Right Bottom-->
    
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="NavView_SelectionChanged"
                        BackRequested="NavView_BackRequested"
                        IsBackEnabled="True">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Document" Content="QR Code Generator" Tag="Wifi" />
                <NavigationViewItem Icon="AllApps" Content="Mass QR Code Generator" Tag="MassQRCode" />
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Frame x:Name="ContentFrame"/>
            </ScrollViewer>
        </NavigationView>

    </Grid>
</Window>
