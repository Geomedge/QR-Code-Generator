<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QR_Code_Generator.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="36,0,36,0">
            <TextBlock Margin="0,40,0,36" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0">Settings</TextBlock>

            <TextBlock Margin="0,0,0,5" Style="{StaticResource BodyStrongTextBlockStyle}">General</TextBlock>
            <StackPanel Spacing="4" Margin="0,0,0,15">
                <controls:SettingsCard x:Name="settingsCard"
                       Header="Hide/Show Elements"
                       Description="Select which elements should be hidden or shown."
                       HeaderIcon="{ui:FontIcon Glyph=&#xE799;}"
                       >
                    <!-- This is the checkboxes for Wifi.xaml elements -->
                    <StackPanel>
                        <CheckBox x:Name="WifiCheckBox" Content="WiFi QR Codes" Margin="24,0,0,0" />
                        <CheckBox x:Name="LinkCheckBox" Content="Link QR Codes" Margin="24,0,0,0" />
                        <CheckBox x:Name="PhoneCheckBox" Content="Phone QR Codes" Margin="24,0,0,0" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="A card with custom objects as its Description"
                           >
                    <controls:SettingsCard.Description>
                        <HyperlinkButton Content="Learn more about Phone Link" />
                    </controls:SettingsCard.Description>
                    <Button Content="Open Phone Link"
                Style="{StaticResource AccentButtonStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="When resizing a SettingsCard, the Content will wrap vertically. You can override this breakpoint by setting the SettingsCardWrapThreshold resource. For edge cases, you can also hide the icon by setting SettingsCardWrapNoIconThreshold."
                           Header="Adaptive layouts"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE745;}"
                           >
                    <controls:SettingsCard.Resources>
                        <x:Double x:Key="SettingsCardWrapThreshold">800</x:Double>
                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">600</x:Double>
                    </controls:SettingsCard.Resources>
                    <Button Content="This control will wrap vertically!"
                Style="{StaticResource AccentButtonStyle}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="This is a card with a Header only" />
            </StackPanel>

            
            <!--Experiments-->
            <TextBlock Margin="0,0,0,5" Style="{StaticResource BodyStrongTextBlockStyle}">Experiments</TextBlock>

            <InfoBar
                IsOpen="True"
                Severity="Warning"
                Title="Experimental Features"
                Message="The following features are still in development. Behaviour may change and some functionality may be incomplete."
                IsClosable="True"
                Margin="0,0,0,5"/>

            <StackPanel Spacing="4" Margin="0,0,0,10">
                <controls:SettingsCard x:Name="settingsCard2"
                Header="Enable Mass QR Code Generation"
                Description="Show new Mass QR Code Generation Menu"
                HeaderIcon="{ui:FontIcon Glyph=&#xE799;}"
                >
                    <!-- This is the checkboxes for Wifi.xaml elements -->
                    <StackPanel>
                        <ToggleSwitch AutomationProperties.Name="Toggle"/>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="A card with custom objects as its Description"
               >
                    <controls:SettingsCard.Description>
                        <HyperlinkButton Content="Learn more about Phone Link" />
                    </controls:SettingsCard.Description>
                    <Button Content="Open Phone Link" Style="{StaticResource AccentButtonStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="When resizing a SettingsCard, the Content will wrap vertically. You can override this breakpoint by setting the SettingsCardWrapThreshold resource. For edge cases, you can also hide the icon by setting SettingsCardWrapNoIconThreshold."
               Header="Adaptive layouts"
               HeaderIcon="{ui:FontIcon Glyph=&#xE745;}"
               >
                    <controls:SettingsCard.Resources>
                        <x:Double x:Key="SettingsCardWrapThreshold">800</x:Double>
                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">600</x:Double>
                    </controls:SettingsCard.Resources>
                    <Button Content="This control will wrap vertically!" Style="{StaticResource AccentButtonStyle}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="This is a card with a Header only" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
